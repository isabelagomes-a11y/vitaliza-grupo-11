a o modelo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#16a34a;fontColor=#15803d;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c25" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="689"/><mxPoint x="205" y="689"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>