;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e62" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="1125"/><mxPoint x="740" y="1232"/></Array></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c42" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c41" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c32" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="880"/><mxPoint x="345" y="1540"/></Array></mxGeometry></mxCell><mxCell id="e73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e75" value="nova versão da regra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#16a34a;fontColor=#15803d;" edge="1" parent="1" source="c46" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1745"/><mxPoint x="1060" y="620"/></Array></mxGeometry></mxCell><mxCell id="e76" value="retreino" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#16a34a;fontColor=#15803d;" edge="1" parent="1" source="c46" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1760"/><mxPoint x="1100" y="525"/></Array></mxGeometry></mxCell><mxCell id="e77" value="próximo mês" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c46" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="1745"/><mxPoint x="380" y="138"/></Array></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;Exemplo&lt;/b&gt;&lt;br&gt;Ana, mensal, treinou 6 dias em setembro, renovação ligada, risco de 38%.&lt;br&gt;→ não desligou · não é anual dorminhoco → &lt;b&gt;desafio&lt;/b&gt; · está no top 1.500 → &lt;b&gt;+ WhatsApp&lt;/b&gt; · não caiu no controle → o LLM escreve o texto → o CRM envia." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;fontSize=11;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="760" y="1420" width="260" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Como o assinante é enquadrado"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0" background="#f8fafc"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;color:#2563eb;letter-spacing:1px&quot;&gt;VITALIZA · MÓDULO 2 · INTELI&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="600" height="18" as="geometry"/></mxCell><mxCell id="c3" value="Três rótulos por assinante, cada um com uma função" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Não existe um perfil único por semelhança. A ação vem da &lt;b&gt;célula&lt;/b&gt; (regras sem pesos); a &lt;b&gt;nota de risco&lt;/b&gt; (pesos aprendidos) só prioriza os canais escassos; o &lt;b&gt;segmento&lt;/b&gt; (distância) só ajusta o tom da mensagem." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Assinante ativo no dia 1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="⚙️ &lt;b&gt;Célula de decisão&lt;/b&gt;&lt;br&gt;&lt;i&gt;regras se/então · sem pesos&lt;/i&gt;&lt;br&gt;&lt;br&gt;Perguntas fixas:&lt;br&gt;• plano (mensal/anual)&lt;br&gt;• renovação desligada?&lt;br&gt;• dias ativos nos últimos 2 meses&lt;br&gt;&lt;br&gt;&lt;b&gt;Define a ação&lt;/b&gt;: desafio, nenhum contato ou CS" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="340" height="230" as="geometry"/></mxCell><mxCell id="c7" value="⚙️ &lt;b&gt;Nota de risco&lt;/b&gt;&lt;br&gt;&lt;i&gt;modelo (gradient boosting) · pesos aprendidos&lt;/i&gt;&lt;br&gt;&lt;br&gt;~50 variáveis (uso, cobrança, rede, texto) combinadas → probabilidade de 0 a 100% de sair em 60 dias.&lt;br&gt;&lt;br&gt;&lt;b&gt;Prioriza&lt;/b&gt; quem recebe WhatsApp (1.500) e CS (300)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="220" width="340" height="230" as="geometry"/></mxCell><mxCell id="c8" value="⚙️ &lt;b&gt;Segmento&lt;/b&gt;&lt;br&gt;&lt;i&gt;k-means · centro mais próximo · pesos iguais após padronização&lt;/i&gt;&lt;br&gt;&lt;br&gt;Assíduos, Treinam em grupo, Moderados (com e sem rede), Recém-chegados, Renovação desligada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ajusta o tom&lt;/b&gt; da mensagem e a comunicação interna" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="340" height="230" as="geometry"/></mxCell><mxCell id="c9" value="⚙️ &lt;b&gt;Decisão final por pessoa&lt;/b&gt;&lt;br&gt;ação + canal + prioridade + tom" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="470" y="510" width="340" height="70" as="geometry"/></mxCell><mxCell id="c10" value="✨ LLM escreve o texto (não decide)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#efe4ff;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="60" as="geometry"/></mxCell><mxCell id="c11" value="📨 CRM envia" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#ffedd5;" vertex="1" parent="1"><mxGeometry x="470" y="740" width="340" height="50" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="ação" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="485"/><mxPoint x="538" y="485"/></Array></mxGeometry></mxCell><mxCell id="e16" value="prioridade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="tom" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="485"/><mxPoint x="742" y="485"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Por que a ação não vem da IA?&lt;/b&gt;&lt;br&gt;Ela depende de um efeito causal medido no sorteio de agosto: contatar o anual que não usa triplica o desligamento. Uma tabela é auditável, estável e mensurável contra o controle." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;fontSize=11;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="340" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Onde entraria um RAG?&lt;/b&gt;&lt;br&gt;Só na mensagem, se a biblioteca de briefings, políticas e mensagens aprovadas crescer. Para decidir, não." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;fontSize=11;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="880" y="510" width="340" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · O que nós fazemos para construir"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0" background="#f8fafc"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;color:#2563eb;letter-spacing:1px&quot;&gt;VITALIZA · MÓDULO 2 · INTELI&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="600" height="18" as="geometry"/></mxCell><mxCell id="c3" value="Procedimento de construção do sistema (CRISP-DM)" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Cada fase usa o resultado da anterior. Verde = feito · amarelo = pendente com o grupo · cinza tracejado = execução na empresa." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="20" width="26" height="20" as="geometry"/></mxCell><mxCell id="c6" value="feito" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1112" y="20" width="120" height="20" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#fef3c7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="46" width="26" height="20" as="geometry"/></mxCell><mxCell id="c8" value="pendente (grupo)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1112" y="46" width="160" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1080" y="72" width="26" height="20" as="geometry"/></mxCell><mxCell id="c10" value="piloto (empresa)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1112" y="72" width="160" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Entender" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c12" value="Preparar e medir" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c13" value="Explicar e segmentar" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c14" value="Prever" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c15" value="Prescrever" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c16" value="Comunicar e pilotar" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#e2e8f0;fontSize=12;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c17" value="✅ &lt;b&gt;1 · Entender o negócio&lt;/b&gt;&lt;br&gt;Ler o enunciado e o dicionário; fixar premissas (preços, taxas, CAC, tetos do CRM).&lt;br&gt;&lt;i&gt;→ resumo do case&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="290" height="110" as="geometry"/></mxCell><mxCell id="c18" value="✅ &lt;b&gt;2 · Qualidade dos dados&lt;/b&gt;&lt;br&gt;Formatos, grafias, fusos, cortesias.&lt;br&gt;&lt;i&gt;→ notebook §1.1&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="290" height="110" as="geometry"/></mxCell><mxCell id="c19" value="✅ &lt;b&gt;3 · Reconstruir a base&lt;/b&gt;&lt;br&gt;Status por eventos; conciliar com os números do enunciado.&lt;br&gt;&lt;i&gt;→ src/base.py · §1.2&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="336" width="290" height="110" as="geometry"/></mxCell><mxCell id="c20" value="✅ &lt;b&gt;4 · Diagnóstico&lt;/b&gt;&lt;br&gt;Decomposição taxa × mix, diferença em diferenças, triangulação do GPS.&lt;br&gt;&lt;i&gt;→ notebook §2&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="516" width="290" height="110" as="geometry"/></mxCell><mxCell id="c21" value="✅ &lt;b&gt;5 · Segmentação&lt;/b&gt;&lt;br&gt;k-means com padronização e silhueta.&lt;br&gt;&lt;i&gt;→ notebook §3&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="516" width="290" height="110" as="geometry"/></mxCell><mxCell id="c22" value="✅ &lt;b&gt;6 · Modelo de risco&lt;/b&gt;&lt;br&gt;Fotos no tempo, validação fora do tempo, 4 modelos, calibração.&lt;br&gt;&lt;i&gt;→ notebook §4&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="696" width="290" height="110" as="geometry"/></mxCell><mxCell id="c23" value="✅ &lt;b&gt;7 · Texto e imagem&lt;/b&gt;&lt;br&gt;Esquema fixo, extração por regras, ablação; imagens descartadas.&lt;br&gt;&lt;i&gt;→ notebook §5&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="696" width="290" height="110" as="geometry"/></mxCell><mxCell id="c24" value="⏳ &lt;b&gt;7b · Rotular 300 textos à mão&lt;/b&gt;&lt;br&gt;Medir o acerto da extração.&lt;br&gt;&lt;i&gt;→ outputs/amostra_rotulagem.csv&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#fef3c7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="696" width="290" height="110" as="geometry"/></mxCell><mxCell id="c25" value="⏳ &lt;b&gt;7c · Extração com LLM real&lt;/b&gt;&lt;br&gt;Trocar as regras pelo LLM; comparar com a rotulagem e medir o custo." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#fef3c7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="696" width="290" height="110" as="geometry"/></mxCell><mxCell id="c26" value="✅ &lt;b&gt;8 · Uplift da campanha&lt;/b&gt;&lt;br&gt;Efeito por célula e mensagem, IC de 95%.&lt;br&gt;&lt;i&gt;→ notebook §6&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="876" width="290" height="110" as="geometry"/></mxCell><mxCell id="c27" value="✅ &lt;b&gt;9 · Regra e retorno&lt;/b&gt;&lt;br&gt;Ação de maior lucro por célula; sensibilidade; orçamento.&lt;br&gt;&lt;i&gt;→ notebook §7 · lista CSV&lt;/i&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="876" width="290" height="110" as="geometry"/></mxCell><mxCell id="c28" value="Grupo revisa e aprova a regra v1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=12;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="876" width="190" height="110" as="geometry"/></mxCell><mxCell id="c29" value="⏳ &lt;b&gt;10 · Mensagem com LLM real&lt;/b&gt;&lt;br&gt;Briefing pronto (§8); falta gerar os textos e revisar uma amostra." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#fef3c7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="876" width="290" height="110" as="geometry"/></mxCell><mxCell id="c30" value="✅ &lt;b&gt;11 · Documentos&lt;/b&gt;&lt;br&gt;Análise detalhada, solução em uma página, plano v2." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="290" height="110" as="geometry"/></mxCell><mxCell id="c31" value="🧪 &lt;b&gt;12 · Piloto nov–dez&lt;/b&gt;&lt;br&gt;Controle de 10%, testes de WhatsApp e CS, retreino mensal." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="380" y="1056" width="290" height="110" as="geometry"/></mxCell><mxCell id="c32" value="Semana 10: escalar, ajustar ou parar" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=12;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="1056" width="190" height="110" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.