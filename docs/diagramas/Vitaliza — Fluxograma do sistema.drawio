<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="1 · Como o sistema roda (todo mês)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0" background="#f8fafc"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;color:#2563eb;letter-spacing:1px&quot;&gt;VITALIZA · MÓDULO 2 · INTELI&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="18" as="geometry"/></mxCell><mxCell id="c3" value="Vitaliza · Sistema de retenção: execução mensal" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Entrada: &lt;b&gt;a base inteira de pagantes ativos&lt;/b&gt;, todo dia 1. Saída: para cada assinante, o risco, a decisão e a mensagem. A decisão vem de uma &lt;b&gt;tabela de regras aprovada por pessoas&lt;/b&gt;; o LLM só extrai campos e escreve o texto." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="860" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Legenda: quem executa&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="30" width="260" height="20" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="1080" y="56" width="30" height="24" as="geometry"/></mxCell><mxCell id="c7" value="⚙️ Código (automático)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="58" width="220" height="22" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#efe4ff;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="30" height="24" as="geometry"/></mxCell><mxCell id="c9" value="✨ LLM (IA generativa)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="92" width="220" height="22" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;" vertex="1" parent="1"><mxGeometry x="1080" y="124" width="30" height="24" as="geometry"/></mxCell><mxCell id="c11" value="👥 Pessoas (revisão e aprovação)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="126" width="220" height="22" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#ffedd5;" vertex="1" parent="1"><mxGeometry x="1080" y="158" width="30" height="24" as="geometry"/></mxCell><mxCell id="c13" value="📨 Ferramenta de CRM (envio)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="160" width="220" height="22" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=none;shadow=1;fontSize=11;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1080" y="192" width="30" height="24" as="geometry"/></mxCell><mxCell id="c15" value="❓ Pergunta da regra" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="194" width="220" height="22" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1080" y="226" width="30" height="24" as="geometry"/></mxCell><mxCell id="c17" value="🗄️ Dados guardados" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="228" width="220" height="22" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="260" width="30" height="24" as="geometry"/></mxCell><mxCell id="c19" value="🚫 Sem contato" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="262" width="220" height="22" as="geometry"/></mxCell><mxCell id="c20" value="Dia 1 do mês" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="200" height="56" as="geometry"/></mxCell><mxCell id="c21" value="🗄️ &lt;b&gt;Fontes&lt;/b&gt;&lt;br&gt;app, lojas (Apple/Google), pagamentos, suporte, rede social" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="240" height="90" as="geometry"/></mxCell><mxCell id="c22" value="⚙️ &lt;b&gt;1 · Dados&lt;/b&gt;&lt;br&gt;reconstrói o status de cada assinatura pelos eventos, limpa e seleciona os pagantes ativos" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="280" height="70" as="geometry"/></mxCell><mxCell id="c23" value="✨ &lt;b&gt;2 · Extração&lt;/b&gt;&lt;br&gt;lê só as frases novas de posts, chamados e questionário e devolve campos: meta cumprida, GPS, lesão…" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#efe4ff;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="280" height="70" as="geometry"/></mxCell><mxCell id="c24" value="🗄️ Cache de frases já extraídas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="c25" value="⚙️ &lt;b&gt;3 · Variáveis&lt;/b&gt;&lt;br&gt;uso, rede, cobrança, renovação, texto" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="280" height="60" as="geometry"/></mxCell><mxCell id="c26" value="⚙️ &lt;b&gt;4 · Modelo de risco&lt;/b&gt;&lt;br&gt;probabilidade de sair em 60 dias (pesos aprendidos dos dados)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="280" height="70" as="geometry"/></mxCell><mxCell id="c27" value="🗄️ Modelo treinado&lt;br&gt;(retreino mensal)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="780" y="490" width="220" height="70" as="geometry"/></mxCell><mxCell id="c28" value="⚙️ &lt;b&gt;5 · Decisão&lt;/b&gt;&lt;br&gt;aplica a tabela de regras a cada pessoa" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="590" width="280" height="60" as="geometry"/></mxCell><mxCell id="c29" value="🗄️ &lt;b&gt;Tabela de regras&lt;/b&gt;&lt;br&gt;versão aprovada pelo comitê" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="780" y="585" width="220" height="70" as="geometry"/></mxCell><mxCell id="c30" value="Já desligou a renovação?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=none;shadow=1;fontSize=11;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="680" width="220" height="110" as="geometry"/></mxCell><mxCell id="c31" value="Está entre os 300 de maior risco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=none;shadow=1;fontSize=11;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="90" y="690" width="220" height="110" as="geometry"/></mxCell><mxCell id="c32" value="📨 Ligação do CS: oferta de pausa de 60 dias (teste)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#ffedd5;" vertex="1" parent="1"><mxGeometry x="90" y="850" width="220" height="60" as="geometry"/></mxCell><mxCell id="c33" value="🚫 Não contatar (perdidos)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="950" width="220" height="50" as="geometry"/></mxCell><mxCell id="c34" value="Anual com ≤ 1 dia ativo nos últimos 2 meses?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=none;shadow=1;fontSize=11;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="830" width="220" height="120" as="geometry"/></mxCell><mxCell id="c35" value="🚫 Não contatar&lt;br&gt;(não perturbe)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="860" width="220" height="60" as="geometry"/></mxCell><mxCell id="c36" value="⚙️ Ação: &lt;b&gt;desafio&lt;/b&gt; por push + e-mail" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="280" height="50" as="geometry"/></mxCell><mxCell id="c37" value="Está entre os 1.500 de maior risco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=none;shadow=1;fontSize=11;spacing=10;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="1070" width="220" height="110" as="geometry"/></mxCell><mxCell id="c38" value="⚙️ + WhatsApp (teste)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="780" y="1095" width="220" height="60" as="geometry"/></mxCell><mxCell id="c39" value="⚙️ &lt;b&gt;Sorteia controle de 10%&lt;/b&gt;&lt;br&gt;que não recebe nada (para medir)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="1220" width="280" height="60" as="geometry"/></mxCell><mxCell id="c40" value="Lista do mês&lt;br&gt;(risco + ação por pessoa)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="780" y="1230" width="220" height="70" as="geometry"/></mxCell><mxCell id="c41" value="✨ &lt;b&gt;6 · Mensagem&lt;/b&gt;&lt;br&gt;escreve o texto de cada pessoa a partir da decisão e dos campos extraídos" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#efe4ff;" vertex="1" parent="1"><mxGeometry x="420" y="1320" width="280" height="70" as="geometry"/></mxCell><mxCell id="c42" value="🗄️ Briefing + guardrails&lt;br&gt;(tom, ofertas, proibições)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;spacing=4;fontFamily=Helvetica;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="780" y="1320" width="220" height="70" as="geometry"/></mxCell><mxCell id="c43" value="👥 Filtro automático + revisão humana de uma amostra" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;" vertex="1" parent="1"><mxGeometry x="420" y="1420" width="280" height="60" as="geometry"/></mxCell><mxCell id="c44" value="📨 &lt;b&gt;CRM envia&lt;/b&gt; push, e-mail e WhatsApp&lt;br&gt;(o LLM não envia nada)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#ffedd5;" vertex="1" parent="1"><mxGeometry x="420" y="1510" width="280" height="60" as="geometry"/></mxCell><mxCell id="c45" value="⚙️ &lt;b&gt;7 · Medição&lt;/b&gt; após 60 dias:&lt;br&gt;saída dos contatados × controle" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#e0ecff;" vertex="1" parent="1"><mxGeometry x="420" y="1610" width="280" height="60" as="geometry"/></mxCell><mxCell id="c46" value="👥 &lt;b&gt;Comitê mensal&lt;/b&gt;&lt;br&gt;revisa os números, ajusta a regra e aprova a nova versão" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeColor=none;shadow=1;fontSize=12;spacing=8;fontFamily=Helvetica;fontColor=#1e293b;fillColor=#dcfce7;" vertex="1" parent="1"><mxGeometry x="420" y="1710" width="280" height="70" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;endSize=7;strokeColor=#94a3b8;strokeWidth=1.6;fontSize=11;fontColor=#475569;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry>